# Hetufy Desktop & Web - Environment Configuration

# Render Backend URL (Example: https://hetufy-api.onrender.com/api)
# In development, leave blank or set to http://localhost:4000/api
VITE_API_BASE_URL=http://localhost:4000/api

# For Production Desktop Build pointing to Render:
# VITE_API_BASE_URL=https://your-hetufy-service.onrender.com/api

# Google OAuth Web Client ID (Web Application in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Google OAuth Desktop Client Credentials (Desktop Application in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID_DESKTOP=your_desktop_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_DESKTOP=your_desktop_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_DESKTOP=your_desktop_client_secret
