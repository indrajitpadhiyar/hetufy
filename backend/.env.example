PORT=4000
MONGO_URI=your_mongodb_connection_string
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis Credentials
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=14130

# Google Drive Service Account Configuration
# Option 1 (Render Secret File): Mount JSON at /etc/secrets/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-service-account.json

# Option 2 (Local Development): Place your JSON key in the backend folder
GOOGLE_KEY_FILE=google-service-account.json

# Option 3 (Optional - specify specific Google Drive Folder IDs):
GOOGLE_DRIVE_FOLDER_ID=1ApqOpYB5UmxN2ri_awGYo8-pUmBFmSZc
GOOGLE_DRIVE_COVER_FOLDER_ID=1YQeXqHn1QrSbvytBb-BxTgFp8WJuOjPV

JWT_SECRET=your_jwt_secret_key
NODE_ENV=development
